
<#
.SYNOPSIS
    This PowerShell script remediates [Windows 11 account lockout duration must be configured to 15 minutes or greater].

.DESCRIPTION
   The account lockout feature, when enabled, prevents brute-force password attacks on the system. 
   This parameter specifies the amount of time that an account will remain locked after the specified number of failed logon attempts.
    [STIG-ID: WN11-AC-000005].

.NOTES
    Author          : Kayode Osituyo
    LinkedIn        : linkedin.com/in/kayode-osituyo-49041a35a
    GitHub          : github.com/kayosituyo
    Date Created    : 2026-09-01
    Last Modified   : 2026-09-02
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : STIG-ID: WN11-AC-000005
    Documentation   : https://stigaview.com/products/win11/v2r3/WN11-AC-000005/

.TESTED ON
    Date(s) Tested  : 2026-09-02
    Tested By       : Kayode Osituyo
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Run this script from an elevated PowerShell session.
#>

# ============================================================
# STIG REMEDIATION
# ============================================================

# Configure Account Lockout Duration to 15 minutes
net accounts /lockoutduration:15

Write-Host "Account Lockout Duration set to 15 minutes." -ForegroundColor Green

# ============================================================
# VERIFICATION
# ============================================================

Write-Host "`nVerification Results:" -ForegroundColor Cyan

$result = net accounts | Select-String "Lockout duration"

Write-Host $result

if ($result -match "15") {
    Write-Host "PASS - Account Lockout Duration is configured for 15 minutes." -ForegroundColor Green
}
else {
    Write-Host "FAIL - Account Lockout Duration is not configured correctly." -ForegroundColor Red
}


