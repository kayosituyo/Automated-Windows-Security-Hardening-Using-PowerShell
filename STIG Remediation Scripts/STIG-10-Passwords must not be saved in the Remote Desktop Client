<#
.SYNOPSIS
    This PowerShell script remediates [Passwords must not be saved in the Remote Desktop Client].

.DESCRIPTION
 Saving passwords in the Remote Desktop Client could allow an unauthorized user to establish a remote desktop session to another system.
 The system must be configured to prevent users from saving passwords in the Remote Desktop Client.
 [STIG-ID: WN11-CC-000270].

.NOTES
    Author          : Kayode Osituyo
    LinkedIn        : linkedin.com/in/kayode-osituyo-49041a35a
    GitHub          : github.com/kayosituyo
    Date Created    : 2026-09-01
    Last Modified   : 2026-09-03
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : STIG-ID: WN11-CC-000270
    Documentation   : https://stigaview.com/products/win11/v2r3/WN11-CC-000270/

.TESTED ON
    Date(s) Tested  : 2026-09-03
    Tested By       : Kayode Osituyo
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Run this script from an elevated PowerShell session.
#>


# ============================================================
# STIG REMEDIATION
# ============================================================

$RegistryPath = "HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services"

# Create registry path if it does not exist
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Enable "Do not allow passwords to be saved"
Set-ItemProperty `
    -Path $RegistryPath `
    -Name "DisablePasswordSaving" `
    -Value 1 `
    -Type DWord `
    -Force

Write-Host "Policy enabled: Users cannot save RDP passwords." `
    -ForegroundColor Green

# ============================================================
# VERIFICATION
# ============================================================

Write-Host "`nVerification Results:" -ForegroundColor Cyan

$result = Get-ItemProperty `
    -Path $RegistryPath `
    -Name "DisablePasswordSaving" `
    -ErrorAction SilentlyContinue

if ($result.DisablePasswordSaving -eq 1) {
    Write-Host "PASS - RDP password saving is disabled." `
        -ForegroundColor Green
}
else {
    Write-Host "FAIL - Policy is not configured correctly." `
        -ForegroundColor Red
}



# ============================================================
# EXPECTED RESULT
# ============================================================

 <# PASS - RDP password saving is disabled. #>
