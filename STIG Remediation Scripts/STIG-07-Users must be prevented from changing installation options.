<#
.SYNOPSIS
    This PowerShell script remediates [Users must be prevented from changing installation options].

.DESCRIPTION
  Installation options for applications are typically controlled by administrators.
  This setting prevents users from changing installation options that may bypass security features.
  [STIG-ID: WN11-CC-000310].

.NOTES
    Author          : Kayode Osituyo
    LinkedIn        : linkedin.com/in/kayode-osituyo-49041a35a
    GitHub          : github.com/kayosituyo
    Date Created    : 2026-09-01
    Last Modified   : 2026-09-03
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : STIG-ID: WN11-CC-000310
    Documentation   : https://stigaview.com/products/win11/v2r3/WN11-CC-000310/

.TESTED ON
    Date(s) Tested  : 2026-09-03
    Tested By       : Kayode Osituyo
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Run this script from an elevated PowerShell session.
#>

# ============================================================
# STIG REMEDIATION
# ============================================================

$RegistryPath = "HKLM:\Software\Policies\Microsoft\Windows\Installer"

# Create registry path if it does not exist
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Disable "Allow user control over installs"
Set-ItemProperty `
    -Path $RegistryPath `
    -Name "EnableUserControl" `
    -Value 0 `
    -Type DWord `
    -Force

Write-Host "Policy disabled: Allow user control over installs." -ForegroundColor Green

# ============================================================
# VERIFICATION
# ============================================================

Write-Host "`nVerification Results:" -ForegroundColor Cyan

$result = Get-ItemProperty `
    -Path $RegistryPath `
    -Name "EnableUserControl" `
    -ErrorAction SilentlyContinue

if ($result.EnableUserControl -eq 0) {
    Write-Host "PASS - Allow user control over installs is disabled." -ForegroundColor Green
}
else {
    Write-Host "FAIL - Policy is not configured correctly." -ForegroundColor Red
}
 


# ============================================================
# EXPECTED RESULT
# ============================================================

 <# PASS - Allow user control over installs is disabled. #>
