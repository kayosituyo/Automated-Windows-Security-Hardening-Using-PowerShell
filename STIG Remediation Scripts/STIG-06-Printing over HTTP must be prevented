.TESTED ON
    Date(s) Tested  : 2026-09-03
    Tested By       : Kayode Osituyo
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Run this script from an elevated PowerShell session.
#>

# ============================================================
# STIG REMEDIATION
# ============================================================

$RegistryPath = "HKLM:\Software\Policies\Microsoft\Windows NT\Printers"

# Create registry path if it does not exist
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Enable "Turn off printing over HTTP"
Set-ItemProperty `
    -Path $RegistryPath `
    -Name "DisableHTTPPrinting" `
    -Value 1 `
    -Type DWord `
    -Force

Write-Host "Policy enabled: Turn off printing over HTTP." -ForegroundColor Green

# ============================================================
# VERIFICATION
# ============================================================

Write-Host "`nVerification Results:" -ForegroundColor Cyan

$result = Get-ItemProperty `
    -Path $RegistryPath `
    -Name "DisableHTTPPrinting" `
    -ErrorAction SilentlyContinue

if ($result.DisableHTTPPrinting -eq 1) {
    Write-Host "PASS - Printing over HTTP is disabled." -ForegroundColor Green
}
else {
    Write-Host "FAIL - Policy is not configured correctly." -ForegroundColor Red
}



# ============================================================
# EXPECTED RESULT
# ============================================================

 <# PASS - Printing over HTTP is disabled #>
