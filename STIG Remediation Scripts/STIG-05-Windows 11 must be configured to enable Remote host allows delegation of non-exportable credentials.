    STIG-ID         : STIG-ID: WN11-CC-000068
    Documentation   : https://stigaview.com/products/win11/v2r3/WN11-CC-000068/

.TESTED ON
    Date(s) Tested  : 2026-09-02
    Tested By       : Kayode Osituyo
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Run this script from an elevated PowerShell session.
#>

# ============================================================
# STIG REMEDIATION
# ============================================================

$RegistryPath = "HKLM:\Software\Policies\Microsoft\Windows\CredentialsDelegation"

# Create registry path if it does not exist
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Enable the policy
Set-ItemProperty `
    -Path $RegistryPath `
    -Name "AllowProtectedCreds" `
    -Value 1 `
    -Type DWord `
    -Force

Write-Host "Policy enabled: Remote host allows delegation of non-exportable credentials." `
    -ForegroundColor Green

# ============================================================
# VERIFICATION
# ============================================================

Write-Host "`nVerification Results:" -ForegroundColor Cyan

$result = Get-ItemProperty `
    -Path $RegistryPath `
    -Name "AllowProtectedCreds" `
    -ErrorAction SilentlyContinue

if ($result.AllowProtectedCreds -eq 1) {
    Write-Host "PASS - Policy is enabled." -ForegroundColor Green
}
else {
    Write-Host "FAIL - Policy is not configured correctly." -ForegroundColor Red
}

# ============================================================
# EXPECTED RESULT
# ============================================================

 <# PASS - Policy is enabled. #>
